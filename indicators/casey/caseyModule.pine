// This source code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// caseyModule — day/week separators, PD-H/PD-L + premarket H/L levels, EMA 13/48/200, VWAP from the start of the day
// Inspired by prev_day_hl/prev_day_hl.pine and vwap_ema_signals/vwap_ema_signals.pine

//@version=6
indicator("caseyModule", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500)

// ─────────────────────────────────────
// INPUTS
// ─────────────────────────────────────
var g_sess = 'Session'
regSession = input.session('0930-1600', 'Regular Session', group=g_sess)
sessTz     = input.string('America/New_York', 'Session Timezone', group=g_sess)
pdMode     = input.string('Regular only', 'PD H/L Range', options=['Regular only', 'Regular + Extended'], group=g_sess,
     tooltip='Regular only: PD-H/PD-L use the regular session bars only. Regular + Extended: every bar of the previous calendar day (in the session timezone).')

var g_sep = 'Day / Week Separators'
showDaySep  = input.bool(true, 'Day', inline='dsep', group=g_sep)
daySepCol   = input.color(color.black, '', inline='dsep', group=g_sep)
daySepW     = input.int(4, '', minval=1, maxval=10, inline='dsep', group=g_sep)
daySepSty   = input.string('Dotted', '', options=['Solid', 'Dashed', 'Dotted'], inline='dsep', group=g_sep)
showWeekSep = input.bool(true, 'Week', inline='wsep', group=g_sep)
weekSepCol  = input.color(#2962FF, '', inline='wsep', group=g_sep)
weekSepW    = input.int(4, '', minval=1, maxval=10, inline='wsep', group=g_sep)
weekSepSty  = input.string('Solid', '', options=['Solid', 'Dashed', 'Dotted'], inline='wsep', group=g_sep)

var g_lvl = 'Key Levels (show · color · width · style)'
showPDH = input.bool(true, 'PD-H ', inline='pdh', group=g_lvl)
pdhCol  = input.color(#4CAF50, '', inline='pdh', group=g_lvl)
pdhW    = input.int(1, '', minval=1, maxval=10, inline='pdh', group=g_lvl)
pdhSty  = input.string('Solid', '', options=['Solid', 'Dashed', 'Dotted'], inline='pdh', group=g_lvl)
showPDL = input.bool(true, 'PD-L ', inline='pdl', group=g_lvl)
pdlCol  = input.color(#F23645, '', inline='pdl', group=g_lvl)
pdlW    = input.int(1, '', minval=1, maxval=10, inline='pdl', group=g_lvl)
pdlSty  = input.string('Solid', '', options=['Solid', 'Dashed', 'Dotted'], inline='pdl', group=g_lvl)
showPMH = input.bool(true, 'Pre-H', inline='pmh', group=g_lvl)
pmhCol  = input.color(#4CAF50, '', inline='pmh', group=g_lvl)
pmhW    = input.int(1, '', minval=1, maxval=10, inline='pmh', group=g_lvl)
pmhSty  = input.string('Dashed', '', options=['Solid', 'Dashed', 'Dotted'], inline='pmh', group=g_lvl)
showPML = input.bool(true, 'Pre-L', inline='pml', group=g_lvl)
pmlCol  = input.color(#F23645, '', inline='pml', group=g_lvl)
pmlW    = input.int(1, '', minval=1, maxval=10, inline='pml', group=g_lvl)
pmlSty  = input.string('Dashed', '', options=['Solid', 'Dashed', 'Dotted'], inline='pml', group=g_lvl)
showPWH = input.bool(true, 'PW-H ', inline='pwh', group=g_lvl)
pwhCol  = input.color(#4CAF50, '', inline='pwh', group=g_lvl)
pwhW    = input.int(2, '', minval=1, maxval=10, inline='pwh', group=g_lvl)
pwhSty  = input.string('Solid', '', options=['Solid', 'Dashed', 'Dotted'], inline='pwh', group=g_lvl)
showPWL = input.bool(true, 'PW-L ', inline='pwl', group=g_lvl)
pwlCol  = input.color(#F23645, '', inline='pwl', group=g_lvl)
pwlW    = input.int(2, '', minval=1, maxval=10, inline='pwl', group=g_lvl)
pwlSty  = input.string('Solid', '', options=['Solid', 'Dashed', 'Dotted'], inline='pwl', group=g_lvl)

var g_lvlOpt = 'Key Levels — Look'
lvlStart   = input.string('Where level was set', 'Line starts at', options=['Where level was set', 'Start of today'], group=g_lvlOpt,
     tooltip='Where level was set: the line begins at the bar that made the high/low. Start of today: all lines begin at the first bar of the current day.')
extRight   = input.bool(true, 'Extend lines to the right', group=g_lvlOpt)
glowOn     = input.bool(false, 'Glow (soft halo behind the line)', group=g_lvlOpt)
glowTransp = input.int(82, 'Glow transparency', minval=0, maxval=100, group=g_lvlOpt)
glowExtra  = input.int(4, 'Glow extra width', minval=1, maxval=10, group=g_lvlOpt)
zoneOn     = input.bool(true, 'Zone (thin band on the level)', group=g_lvlOpt,
     tooltip='A translucent band hugging each level: below a high (PD-H, Pre-H), above a low (PD-L, Pre-L).')
zoneMode   = input.string('ATR', 'Zone thickness', options=['ATR', 'Price tier'], inline='zn', group=g_lvlOpt,
     tooltip='ATR: previous day\'s daily ATR × multiplier. Price tier: 0.10 below $50, 0.25 up to $100, 0.50 above.')
atrLen     = input.int(14, 'ATR len', minval=1, inline='zn', group=g_lvlOpt)
atrMult    = input.float(0.03, '×', minval=0.0, step=0.01, inline='zn', group=g_lvlOpt)
zoneTransp = input.int(80, 'Zone transparency', minval=0, maxval=100, group=g_lvlOpt)
lblStyle   = input.string('Filled tag', 'Label style', options=['Filled tag', 'Text only'], group=g_lvlOpt,
     tooltip='Filled tag: solid colored tag sitting on the line, text in black or white by contrast. Text only: colored text above a high / below a low.')
lblSize    = input.string('Large', 'Label size', options=['Small', 'Normal', 'Large', 'Huge'], inline='lbl', group=g_lvlOpt)
showPrice  = input.bool(false, 'Show price', inline='lbl', group=g_lvlOpt)
tagTxt     = input.string('Black', 'Tag text color', options=['Black', 'White', 'Auto'], group=g_lvlOpt,
     tooltip='Text color inside the filled tags. Auto picks black or white by the tag color\'s brightness.')
lblOffset  = input.int(3, 'Label offset (bars right)', minval=0, maxval=50, group=g_lvlOpt)
lblStagger = input.int(5, 'PD labels extra offset (bars)', minval=0, maxval=50, group=g_lvlOpt,
     tooltip='Pushes the PD-H/PD-L tags further right than Pre-H/Pre-L so they do not overlap when the levels are close. PW-H/PW-L tags go twice as far.')
showHist   = input.bool(false, 'Show levels on previous days', group=g_lvlOpt,
     tooltip="Draws each past day's PD-H/PD-L/Pre-H/Pre-L as a segment spanning that day (thin, no glow). Uses the shared 500-line budget.")
histTransp = input.int(40, 'Previous days transparency', minval=0, maxval=100, group=g_lvlOpt)

var g_ema = 'EMAs (show · length · color · width)'
showE1 = input.bool(true, 'EMA 1', inline='e1', group=g_ema)
e1Len  = input.int(13, '', minval=1, inline='e1', group=g_ema)
e1Col  = input.color(#2962FF, '', inline='e1', group=g_ema)
e1W    = input.int(4, '', minval=1, maxval=4, inline='e1', group=g_ema)
showE2 = input.bool(true, 'EMA 2', inline='e2', group=g_ema)
e2Len  = input.int(48, '', minval=1, inline='e2', group=g_ema)
e2Col  = input.color(#4CAF50, '', inline='e2', group=g_ema)
e2W    = input.int(4, '', minval=1, maxval=4, inline='e2', group=g_ema)
showE3 = input.bool(true, 'EMA 3', inline='e3', group=g_ema)
e3Len  = input.int(200, '', minval=1, inline='e3', group=g_ema)
e3Col  = input.color(#FF9800, '', inline='e3', group=g_ema)
e3W    = input.int(4, '', minval=1, maxval=4, inline='e3', group=g_ema)

var g_vw = 'VWAP'
showVwap   = input.bool(true, 'VWAP', inline='vw', group=g_vw)
vwCol      = input.color(#E040FB, '', inline='vw', group=g_vw)
vwW        = input.int(2, '', minval=1, maxval=4, inline='vw', group=g_vw)
vwSrc      = input.source(hlc3, 'Source', group=g_vw)
vwAnchor   = input.string('Start of day (incl. premarket)', 'Anchor', options=['Start of day (incl. premarket)', 'Regular open'], group=g_vw,
     tooltip='Start of day: resets on the first bar of the calendar day (04:00 ET with extended hours on). Regular open: resets at the regular session open and is hidden outside the regular session.')

var g_tbl = 'Bias Table & Background'
showTable  = input.bool(true, 'Show table', group=g_tbl)
tblPos     = input.string('Top Right', 'Position', options=['Top Right', 'Top Left', 'Middle Right', 'Bottom Right', 'Bottom Left'], group=g_tbl)
tblSize    = input.string('Normal', 'Text size', options=['Small', 'Normal', 'Large', 'Huge'], group=g_tbl)
showBg     = input.bool(false, 'Background on full bull / full bear', group=g_tbl,
     tooltip='Full bull: close above PD-H and Pre-H, and close > EMA 1 > EMA 2 > EMA 3. Full bear is the mirror. Pre-H/Pre-L are skipped while premarket is still forming or when the chart has no premarket data.')
bullCol    = input.color(#4CAF50, 'Bull', inline='bc', group=g_tbl)
bearCol    = input.color(#F23645, 'Bear', inline='bc', group=g_tbl)
bgTransp   = input.int(88, 'Full bull/bear transparency', minval=0, maxval=100, group=g_tbl)
testTransp = input.int(65, 'EMA test transparency', minval=0, maxval=100, group=g_tbl,
     tooltip='Stronger tint for the entry bar: after a full bull (bear) on the same day, the low (high) reaches EMA 1 and the close holds above (below) EMA 2.')

// ─────────────────────────────────────
// HELPERS
// ─────────────────────────────────────
_style(string s) =>
    s == 'Solid' ? line.style_solid : s == 'Dashed' ? line.style_dashed : line.style_dotted

_size(string s) =>
    s == 'Huge' ? size.huge : s == 'Large' ? size.large : s == 'Normal' ? size.normal : size.small

// black text on light tags, white on dark
_txtCol(color bg) =>
    0.299 * color.r(bg) + 0.587 * color.g(bg) + 0.114 * color.b(bg) > 160 ? color.black : color.white

// previous day's daily ATR (the [1] keeps today's unfinished bar out)
dATR = request.security(syminfo.tickerid, 'D', ta.atr(atrLen)[1], lookahead=barmerge.lookahead_on)

_thick(float y) =>
    zoneMode == 'ATR' and not na(dATR) ? dATR * atrMult : y > 100 ? 0.50 : y > 50 ? 0.25 : 0.10

// band hugging the level: below a high, above a low
_zone(int x1, int x2, float y, bool isHigh, color col, int transp, string ext) =>
    t = _thick(y)
    box.new(x1, isHigh ? y : y + t, x2, isHigh ? y - t : y, xloc=xloc.bar_time, extend=ext,
         border_color=color.new(col, 100), bgcolor=color.new(col, transp))

// ─────────────────────────────────────
// DAY / WEEK / SESSION DETECTION (calendar day in the session timezone)
// ─────────────────────────────────────
isIntra  = timeframe.isintraday
dom      = dayofmonth(time, sessTz)
dow      = dayofweek(time, sessTz)
newDay   = na(time[1]) or dom != dom[1]
newWeek  = na(time[1]) or (newDay and dow < dow[1]) or (time - time[1]) > 7 * 86400000

inRegular   = not na(time(timeframe.period, regSession, sessTz))
regStartMin = int(str.tonumber(str.substring(regSession, 0, 2))) * 60 + int(str.tonumber(str.substring(regSession, 2, 4)))
barMin      = hour(time, sessTz) * 60 + minute(time, sessTz)
isPre       = not inRegular and barMin < regStartMin

// ─────────────────────────────────────
// SEPARATORS
// ─────────────────────────────────────
// on a week boundary the week line replaces the day line
if showWeekSep and newWeek and (isIntra or timeframe.isdaily)
    line.new(bar_index, low, bar_index, high, color=weekSepCol, width=weekSepW, style=_style(weekSepSty), extend=extend.both)
else if showDaySep and newDay and isIntra
    line.new(bar_index, low, bar_index, high, color=daySepCol, width=daySepW, style=_style(daySepSty), extend=extend.both)

// ─────────────────────────────────────
// PREVIOUS DAY H/L + PREMARKET H/L + PREVIOUS WEEK H/L
// ─────────────────────────────────────
var int dayStart = na

// running extremes of the current day (regular only or full day, per pdMode)
var float curH = na
var int   curHT = na
var float curL = na
var int   curLT = na

// previous day's extremes
var float pdH = na
var int   pdHT = na
var float pdL = na
var int   pdLT = na

// running extremes of the current week, and the previous week's (same bars as PD, per pdMode)
var float cwH = na
var int   cwHT = na
var float cwL = na
var int   cwLT = na
var float pwH = na
var int   pwHT = na
var float pwL = na
var int   pwLT = na

// today's premarket extremes
var float pmH = na
var int   pmHT = na
var float pmL = na
var int   pmLT = na

if newDay and isIntra
    // freeze the day that just ended as a history segment before rolling
    if showHist and not na(dayStart)
        endT = time[1]
        hzT  = zoneTransp + int((100 - zoneTransp) * histTransp / 100)
        if zoneOn
            if showPDH and not na(pdH)
                _zone(dayStart, endT, pdH, true, pdhCol, hzT, extend.none)
            if showPDL and not na(pdL)
                _zone(dayStart, endT, pdL, false, pdlCol, hzT, extend.none)
            if showPMH and not na(pmH)
                _zone(pmHT, endT, pmH, true, pmhCol, hzT, extend.none)
            if showPML and not na(pmL)
                _zone(pmLT, endT, pmL, false, pmlCol, hzT, extend.none)
            if showPWH and not na(pwH)
                _zone(dayStart, endT, pwH, true, pwhCol, hzT, extend.none)
            if showPWL and not na(pwL)
                _zone(dayStart, endT, pwL, false, pwlCol, hzT, extend.none)
        if showPDH and not na(pdH)
            line.new(dayStart, pdH, endT, pdH, xloc=xloc.bar_time, color=color.new(pdhCol, histTransp), width=1, style=_style(pdhSty))
        if showPDL and not na(pdL)
            line.new(dayStart, pdL, endT, pdL, xloc=xloc.bar_time, color=color.new(pdlCol, histTransp), width=1, style=_style(pdlSty))
        if showPMH and not na(pmH)
            line.new(pmHT, pmH, endT, pmH, xloc=xloc.bar_time, color=color.new(pmhCol, histTransp), width=1, style=_style(pmhSty))
        if showPML and not na(pmL)
            line.new(pmLT, pmL, endT, pmL, xloc=xloc.bar_time, color=color.new(pmlCol, histTransp), width=1, style=_style(pmlSty))
        if showPWH and not na(pwH)
            line.new(dayStart, pwH, endT, pwH, xloc=xloc.bar_time, color=color.new(pwhCol, histTransp), width=1, style=_style(pwhSty))
        if showPWL and not na(pwL)
            line.new(dayStart, pwL, endT, pwL, xloc=xloc.bar_time, color=color.new(pwlCol, histTransp), width=1, style=_style(pwlSty))

    // roll only if the finished day actually had qualifying bars (skips holidays / empty days)
    if not na(curH)
        pdH  := curH
        pdHT := curHT
        pdL  := curL
        pdLT := curLT
    curH := na
    curL := na
    if newWeek
        if not na(cwH)
            pwH  := cwH
            pwHT := cwHT
            pwL  := cwL
            pwLT := cwLT
        cwH := na
        cwL := na
    pmH  := na
    pmL  := na
    dayStart := time

useBar = pdMode == 'Regular only' ? inRegular : true
if isIntra and useBar
    if na(curH) or high > curH
        curH  := high
        curHT := time
    if na(curL) or low < curL
        curL  := low
        curLT := time
    if na(cwH) or high > cwH
        cwH  := high
        cwHT := time
    if na(cwL) or low < cwL
        cwL  := low
        cwLT := time

if isIntra and isPre
    if na(pmH) or high > pmH
        pmH  := high
        pmHT := time
    if na(pmL) or low < pmL
        pmL  := low
        pmLT := time

// current-day level lines are redrawn on the last bar only
var line[]  lvlLines  = array.new_line()
var label[] lvlLabels = array.new_label()
var box[]   lvlBoxes  = array.new_box()

_drawLevel(bool on, float y, int tSet, string name, color col, int w, string sty, bool isHigh, int stagger) =>
    if on and not na(y)
        x1   = lvlStart == 'Start of today' or na(tSet) ? dayStart : tSet
        x2   = time
        ext  = extRight ? extend.right : extend.none
        if zoneOn
            array.push(lvlBoxes, _zone(x1, x2, y, isHigh, col, zoneTransp, ext))
        if glowOn
            array.push(lvlLines, line.new(x1, y, x2, y, xloc=xloc.bar_time, extend=ext, color=color.new(col, glowTransp), width=w + glowExtra, style=line.style_solid))
        array.push(lvlLines, line.new(x1, y, x2, y, xloc=xloc.bar_time, extend=ext, color=col, width=w, style=_style(sty)))
        lx  = time + (lblOffset + stagger) * timeframe.in_seconds() * 1000
        txt = showPrice ? name + '  ' + str.tostring(y, format.mintick) : name
        if lblStyle == 'Filled tag'
            array.push(lvlLabels, label.new(lx, y, txt, xloc=xloc.bar_time, color=col, textcolor=tagTxt == 'Black' ? color.black : tagTxt == 'White' ? color.white : _txtCol(col), size=_size(lblSize),
                 style=label.style_label_left))
        else
            array.push(lvlLabels, label.new(lx, y, txt, xloc=xloc.bar_time, color=color.new(col, 100), textcolor=col, size=_size(lblSize),
                 style=isHigh ? label.style_label_lower_left : label.style_label_upper_left))

if barstate.islast and isIntra
    for ln in lvlLines
        line.delete(ln)
    for lb in lvlLabels
        label.delete(lb)
    for bx in lvlBoxes
        box.delete(bx)
    array.clear(lvlLines)
    array.clear(lvlLabels)
    array.clear(lvlBoxes)
    _drawLevel(showPDH, pdH, pdHT, 'PD-H',  pdhCol, pdhW, pdhSty, true,  lblStagger)
    _drawLevel(showPDL, pdL, pdLT, 'PD-L',  pdlCol, pdlW, pdlSty, false, lblStagger)
    _drawLevel(showPMH, pmH, pmHT, 'Pre-H', pmhCol, pmhW, pmhSty, true,  0)
    _drawLevel(showPML, pmL, pmLT, 'Pre-L', pmlCol, pmlW, pmlSty, false, 0)
    _drawLevel(showPWH, pwH, pwHT, 'PW-H',  pwhCol, pwhW, pwhSty, true,  2 * lblStagger)
    _drawLevel(showPWL, pwL, pwLT, 'PW-L',  pwlCol, pwlW, pwlSty, false, 2 * lblStagger)

// ─────────────────────────────────────
// EMAs
// ─────────────────────────────────────
e1 = ta.ema(close, e1Len)
e2 = ta.ema(close, e2Len)
e3 = ta.ema(close, e3Len)
plot(e1, 'EMA 1', color=e1Col, linewidth=e1W, display=showE1 ? display.all : display.none)
plot(e2, 'EMA 2', color=e2Col, linewidth=e2W, display=showE2 ? display.all : display.none)
plot(e3, 'EMA 3', color=e3Col, linewidth=e3W, display=showE3 ? display.all : display.none)

// ─────────────────────────────────────
// VWAP from the start of the day
// ─────────────────────────────────────
anchorDay = vwAnchor == 'Start of day (incl. premarket)'
regOpen   = inRegular and not inRegular[1]
vwapValue = ta.vwap(vwSrc, anchorDay ? newDay : regOpen)
vwapShown = isIntra and (anchorDay or inRegular) ? vwapValue : na
plot(vwapShown, 'VWAP', color=vwCol, linewidth=vwW, style=plot.style_linebr, display=showVwap ? display.all : display.none)

// ─────────────────────────────────────
// BIAS: full bull / full bear + 13–48 EMA test
// ─────────────────────────────────────
pmAvail  = not na(pmH) and not isPre
pdState  = na(pdH) ? 0 : close > pdH ? 1 : close < pdL ? -1 : 0
pmState  = not pmAvail ? 0 : close > pmH ? 1 : close < pmL ? -1 : 0
stackBull = e1 > e2 and e2 > e3
stackBear = e1 < e2 and e2 < e3
emaState  = close > e1 and stackBull ? 1 : close < e1 and stackBear ? -1 : 0

fullBull = isIntra and pdState == 1 and (not pmAvail or pmState == 1) and emaState == 1
fullBear = isIntra and pdState == -1 and (not pmAvail or pmState == -1) and emaState == -1

// armed after a full bull/bear today; stays armed through a pullback that holds EMA 2
var bool bullArmed = false
var bool bearArmed = false
if newDay
    bullArmed := false
    bearArmed := false
if fullBull
    bullArmed := true
    bearArmed := false
if fullBear
    bearArmed := true
    bullArmed := false

testBull = bullArmed and stackBull and low <= e1 and close >= e2
testBear = bearArmed and stackBear and high >= e1 and close <= e2

if bullArmed and (close < e2 or not stackBull)
    bullArmed := false
if bearArmed and (close > e2 or not stackBear)
    bearArmed := false

bgcolor(not showBg ? na :
     testBull ? color.new(bullCol, testTransp) :
     testBear ? color.new(bearCol, testTransp) :
     fullBull ? color.new(bullCol, bgTransp) :
     fullBear ? color.new(bearCol, bgTransp) : na, title='Bias background')

// ─────────────────────────────────────
// TABLE
// ─────────────────────────────────────
_pos(string s) =>
    switch s
        'Top Left'     => position.top_left
        'Middle Right' => position.middle_right
        'Bottom Right' => position.bottom_right
        'Bottom Left'  => position.bottom_left
        => position.top_right

_stateBg(int st) =>
    st == 1 ? color.new(bullCol, 30) : st == -1 ? color.new(bearCol, 30) : color.new(color.gray, 80)

_stateFg(int st) =>
    st == 0 ? chart.fg_color : color.white

var table tb = table.new(_pos(tblPos), 2, 4, border_width=1, border_color=color.new(color.gray, 60))

_row(int r, string name, string txt, int st) =>
    ts = _size(tblSize)
    table.cell(tb, 0, r, name, text_color=chart.fg_color, bgcolor=color.new(color.gray, 85), text_size=ts, text_halign=text.align_left)
    table.cell(tb, 1, r, txt, text_color=_stateFg(st), bgcolor=_stateBg(st), text_size=ts, text_halign=text.align_left)

if barstate.islast and showTable and isIntra
    l1 = str.tostring(e1Len)
    l2 = str.tostring(e2Len)
    l3 = str.tostring(e3Len)

    pdTxt = na(pdH) ? 'n/a' : pdState == 1 ? 'Above PD-H' : pdState == -1 ? 'Below PD-L' : 'Inside PD range'
    pmTxt = not pmAvail ? (isPre ? 'Premarket forming' : 'n/a (no premarket)') :
         pmState == 1 ? 'Above Pre-H' : pmState == -1 ? 'Below Pre-L' : 'Inside Pre range'
    emTxt = emaState == 1 ? 'P > ' + l1 + ' > ' + l2 + ' > ' + l3 :
         emaState == -1 ? 'P < ' + l1 + ' < ' + l2 + ' < ' + l3 : 'Mixed'

    setupSt  = testBull or fullBull or bullArmed ? 1 : testBear or fullBear or bearArmed ? -1 : 0
    setupTxt = testBull ? 'BULL: testing ' + l1 + '–' + l2 + ' (entry zone)' :
         fullBull ? 'FULL BULL: wait for ' + l1 + '/' + l2 + ' test' :
         bullArmed ? 'Bull armed: wait for ' + l1 + '/' + l2 + ' test' :
         testBear ? 'BEAR: testing ' + l1 + '–' + l2 + ' (entry zone)' :
         fullBear ? 'FULL BEAR: wait for ' + l1 + '/' + l2 + ' test' :
         bearArmed ? 'Bear armed: wait for ' + l1 + '/' + l2 + ' test' : 'No extreme'

    _row(0, 'Prev day', pdTxt, pdState)
    _row(1, 'Premarket', pmTxt, pmState)
    _row(2, 'EMA stack', emTxt, emaState)
    _row(3, 'Setup', setupTxt, setupSt)
