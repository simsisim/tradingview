//@version=6
// =============================================================================
// XLP 30-Day Intraday Accumulation / Distribution Signal
// Reconstruction of Tom Bowley's (EarningsBeats.com) "@XLP30DAY / @XLP30DLT"
// StockCharts User-Defined Index.
//
// Idea: institutions accumulate defensive consumer-staples (XLP) DURING the
// cash session ahead of major S&P 500 tops, and dump them into capitulation
// lows. Measuring open->close (gaps excluded) isolates that "daytime" flow.
//
// Construction (as best it can be inferred from the reports):
//   dailyIntradayRet% = (close/open - 1) * 100          <- one bar, gap excluded
//   cum30             = rolling 30-trading-day sum of dailyIntradayRet%
//   signal            = 100 + cum30                     <- 100 = neutral centerline
//
// Bowley's thresholds:
//   >= 106  -> heavy intraday ACCUMULATION of staples -> S&P top warning
//   <= 94   -> heavy intraday DISTRIBUTION of staples -> S&P bottom / bullish
// =============================================================================
indicator("XLP 30-Day Intraday Signal", "XLP30", overlay = false, precision = 2)

// ─── Inputs ───────────────────────────────────────────────────────────────────
etf         = input.symbol("AMEX:XLP", "Sector ETF")
len         = input.int(30,   "Rolling window (trading days)", minval = 1)
topLvl      = input.float(106, "Top-warning level")
botLvl      = input.float(94,  "Bottom / capitulation level")
useCompound = input.bool(false, "Compound daily returns (default = simple sum)")
showRawZero = input.bool(false, "Plot raw cumulative % (centre 0) instead of 100-index")
useAnchor   = input.bool(false, "Limit start date")
anchor      = input.time(timestamp("04 Jan 2022 00:00 +0000"), "Set start date",
     tooltip = "When 'Limit start date' is on, nothing is plotted before this bar. The 30-day window itself is unaffected. Bowley's chart begins 2022-01-04.")

// ─── Daily open/close, independent of the chart's symbol & timeframe ──────────
[o, c] = request.security(etf, "D", [open, close], lookahead = barmerge.lookahead_off)

// one bar's intraday (open→close) return, in %. Overnight gap excluded by design.
ret = (c / o - 1.0) * 100.0

// ─── 30-day cumulative ───────────────────────────────────────────────────────
var float cum = na
if useCompound
    float p = 1.0
    for i = 0 to len - 1
        p *= 1.0 + nz(ret[i]) / 100.0
    cum := (p - 1.0) * 100.0
else
    cum := math.sum(ret, len)

signal = (showRawZero ? 0.0 : 100.0) + cum
mid    = showRawZero ? 0.0 : 100.0
top    = showRawZero ? topLvl - 100.0 : topLvl
bot    = showRawZero ? botLvl - 100.0 : botLvl

// ─── Plot ────────────────────────────────────────────────────────────────────
visible = not useAnchor or time >= anchor
plotVal = visible ? signal : na

plot(plotVal, "XLP30", color = color.new(color.teal, 0), linewidth = 2)
hline(mid, "Centerline", color = color.new(color.gray, 40), linestyle = hline.style_dashed)
hline(top, "Top warning",  color = color.new(color.red, 0))
hline(bot, "Bottom signal", color = color.new(color.green, 0))

bgcolor(visible and plotVal >= top ? color.new(color.red, 85) : visible and plotVal <= bot ? color.new(color.green, 85) : na, title = "State")

// optional alerts
alertcondition(ta.crossover(signal, top),  "XLP30 crossed ABOVE top level",  "XLP 30-day intraday signal >= top-warning level")
alertcondition(ta.crossunder(signal, bot), "XLP30 crossed BELOW bottom level","XLP 30-day intraday signal <= capitulation level")
