    if alertOnUndervalued and undervaluedCondition
        alert(createAlertMessage(showIndex1 and isUndervalued(valuationIndex1) and not isUndervalued(valuationIndex1[1]), showIndex2 and isUndervalued(valuationIndex2) and not isUndervalued(valuationIndex2[1]), showIndex3 and isUndervalued(valuationIndex3) and not isUndervalued(valuationIndex3[1]), 'Undervalued'), alertFreq)

    if alertOnOverToNormal and overToNormalCondition
