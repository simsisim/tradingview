// Alert Functions - Multi-Security Alert System
// Alerts trigger when enough securities meet your criteria simultaneously
// This reduces false signals by requiring consensus across multiple assets

// - requiredSecurities = How many of your 3 indices must agree
// - Example: Set to 2 means at least 2 securities must be overvalued for alert
// - This creates more reliable signals by avoiding single-security noise
//
//@param condition1, condition2, condition3 bool Conditions for each security
//@returns bool True if enough securities meet the condition
alertConditionMet(condition1, condition2, condition3) =>
    count = (condition1 ? 1 : 0) + (condition2 ? 1 : 0) + (condition3 ? 1 : 0)
    count >= requiredSecurities

// Optimized alert message creation - manual array joining for Pine Script compatibility
createAlertMessage(security1, security2, security3, alertType) =>
    var string[] triggeredSecurities = array.new_string(0)
    if security1
        array.push(triggeredSecurities, getBaseTickerName(correlationWithSecurity1))
    if security2
        array.push(triggeredSecurities, getBaseTickerName(correlationWithSecurity2))
    if security3
        array.push(triggeredSecurities, getBaseTickerName(correlationWithSecurity3))

    // Manually join array elements (Pine Script doesn't have str.join)
    joinedSecurities = ''
    for i = 0 to array.size(triggeredSecurities) - 1
        if i > 0
            joinedSecurities := joinedSecurities + ', '
        joinedSecurities := joinedSecurities + array.get(triggeredSecurities, i)

    message = alertType + ' alert triggered for: ' + joinedSecurities
    message

// Helper function to check valuation transition
checkValuationTransition(currentStatus, previousStatus) => // Over to Normal (previousStatus == -1 and currentStatus == 0) or  // Under to Normal (previousStatus != 1 and currentStatus == 1) or  // Normal/Under to Over (previousStatus != -1 and currentStatus == -1)  // Normal/Over to Under
    previousStatus == 1 and currentStatus == 0 or previousStatus == -1 and currentStatus == 0 or previousStatus != 1 and currentStatus == 1 or previousStatus != -1 and currentStatus == -1

// Alert Conditions
overvaluedCondition = alertConditionMet(showIndex1 and isOvervalued(valuationIndex1) and not isOvervalued(valuationIndex1[1]), showIndex2 and isOvervalued(valuationIndex2) and not isOvervalued(valuationIndex2[1]), showIndex3 and isOvervalued(valuationIndex3) and not isOvervalued(valuationIndex3[1]))

undervaluedCondition = alertConditionMet(showIndex1 and isUndervalued(valuationIndex1) and not isUndervalued(valuationIndex1[1]), showIndex2 and isUndervalued(valuationIndex2) and not isUndervalued(valuationIndex2[1]), showIndex3 and isUndervalued(valuationIndex3) and not isUndervalued(valuationIndex3[1]))

overToNormalCondition = alertConditionMet(showIndex1 and isOvervalued(valuationIndex1[1]) and isNormal(valuationIndex1), showIndex2 and isOvervalued(valuationIndex2[1]) and isNormal(valuationIndex2), showIndex3 and isOvervalued(valuationIndex3[1]) and isNormal(valuationIndex3))

underToNormalCondition = alertConditionMet(showIndex1 and isUndervalued(valuationIndex1[1]) and isNormal(valuationIndex1), showIndex2 and isUndervalued(valuationIndex2[1]) and isNormal(valuationIndex2), showIndex3 and isUndervalued(valuationIndex3[1]) and isNormal(valuationIndex3))

