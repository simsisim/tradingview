// WVI function - Core Valuation Index Calculation
// This function implements Larry Williams' WillVal (Valuation) Index methodology
// It compares the current asset's price to a correlation security and normalizes the result
//@returns float Normalized valuation index (0-100 scale)

wvi(correlationSecurity) =>
    // Get data for current timeframe (either custom or chart timeframe)
    tf = getCurrentTimeframe()
    c = request.security(syminfo.tickerid, tf, close)  // Current asset's price
    cg = request.security(correlationSecurity, tf, close)  // Correlation security price

    // Step 1: Calculate basic valuation ratio (current price vs correlation security)
    // This creates the foundation - how expensive is the asset relative to its correlate?
    valuationIndex = c / cg * 100

    // Step 2: Apply dual EMA smoothing to create momentum oscillator
    // Short EMA (valuationIndexLength1) minus Long EMA (valuationIndexLength2)
    // This identifies trends in the valuation relationship
    avgValuationIndex1 = ta.ema(valuationIndex, valuationIndexLength1)
    avgValuationIndex2 = ta.ema(valuationIndex, valuationIndexLength2)
    vIndex = avgValuationIndex1 - avgValuationIndex2

    // Step 3: Find historical extremes for normalization
    // Uses vIndexRLength bars (default 156 = ~3 years of weekly data per Larry Williams)
    highestHighVIndex = ta.highest(vIndex, vIndexRLength)
    lowestLowVindex = ta.lowest(vIndex, vIndexRLength)

    // Step 4: Normalize to 0-100 scale using historical range
    // This is Larry Williams' signature approach - put everything on comparable scale
    vIndexR = (vIndex - lowestLowVindex) / (highestHighVIndex - lowestLowVindex) * 100
    vIndexR

// Calculate WVI for each index
valuationIndex1 = wvi(correlationWithSecurity1)
valuationIndex2 = wvi(correlationWithSecurity2)
valuationIndex3 = wvi(correlationWithSecurity3)

// Auto levels calculation - Dynamic Over/Under Valuation Thresholds
// Instead of fixed levels (like 85/15), this calculates adaptive thresholds based on recent market behavior
// This helps the indicator stay relevant during different market conditions
//
// - Takes average of all three valuation indices for stability
// - Looks back 'barAgoForLimits' bars to find recent extremes
// - Applies smoothing with 'levelsMultiplier' to create final thresholds
// - Thresholds adjust automatically as market conditions change
//
//@return tuple [overValue, underValue] - Dynamic over/under valuation thresholds
calcAutoLevels(index1, index2, index3) =>
    // Average all indices for more stable level calculation
    avgIndex = (index1 + index2 + index3) / 3

    // Find recent price extremes (not all-time highs/lows)
    highestHigh = ta.highest(avgIndex, barAgoForLimits)
    lowestLow = ta.lowest(avgIndex, barAgoForLimits)

    // Apply smoothing to create final thresholds
    // levelsMultiplier creates a buffer zone around recent extremes
    overValue = ta.sma(highestHigh, int(barAgoForLimits * levelsMultiplier))
    underValue = ta.sma(lowestLow, int(barAgoForLimits * levelsMultiplier))

    [overValue, underValue]

[overValueAuto, underValueAuto] = calcAutoLevels(valuationIndex1, valuationIndex2, valuationIndex3)

// Valuation status functions - Determine if asset is over/under/normal valued
// These functions classify each valuation index reading based on your chosen thresholds

// - isUndervalued: Index below threshold = potential buying opportunity
// - isOvervalued: Index above threshold = potential selling opportunity
// - isNormal: Index between thresholds = neutral valuation
// - Supports both Manual (fixed) and Auto (adaptive) thresholds
//
//@param index float The valuation index value to classify
//@returns bool True if condition met, false otherwise
isUndervalued(index) =>
    indexColoring == 'AutoLevels' ? index < underValueAuto : index < underValuationLevelManual

isOvervalued(index) =>
    indexColoring == 'AutoLevels' ? index > overValueAuto : index > overValuationLevelManual

isNormal(index) =>
    indexColoring == 'AutoLevels' ? index >= underValueAuto and index <= overValueAuto : index >= underValuationLevelManual and index <= overValuationLevelManual

