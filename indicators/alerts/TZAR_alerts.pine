        alert('{"content":"🟢 BUY ZONE: COHR entered buy zone $' + str.tostring(upper1) + '-$' + str.tostring(lower1) + ' [Timeframe: ' + tf + '] - hfhsghdgs"}', alert.freq_once_per_bar_close)
